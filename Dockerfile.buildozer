FROM python:3.12-slim-bookworm

# Mirror kivy/buildozer: run as root, HOME=/home/user so the
# named volume at /home/user/.buildozer is used for SDK/NDK cache.
ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/user
ENV HOME_DIR=/home/user
ENV PATH="/home/user/.cargo/bin:/home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# System packages needed by buildozer + p4a (building CPython and all recipes for Android)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git zip unzip wget curl \
    openjdk-17-jdk-headless \
    build-essential autoconf automake libtool pkg-config cmake \
    libssl-dev libffi-dev libltdl-dev \
    zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    libncurses5-dev libncursesw5-dev libgdbm-dev liblzma-dev \
    libexpat1-dev \
    lzip patchelf \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/user

# Rust toolchain: required by the p4a cryptography recipe (Rust-based pyo3/cffi backend).
# HOME=/home/user so rustup installs to /home/user/.cargo and /home/user/.rustup.
# Pre-add aarch64-linux-android target so the cryptography cross-build can proceed.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --no-modify-path --default-toolchain stable && \
    /home/user/.cargo/bin/rustup target add aarch64-linux-android

# setuptools provides the distutils shim removed from Python 3.12 stdlib.
# Cython 3.0.x is compatible with kivy 2.3.0.
RUN pip install --no-cache-dir \
        setuptools Cython==3.0.11 \
        buildozer==1.5.0 sh==2.0.7 colorama jinja2 appdirs \
        packaging toml build meson ninja rich

# Symlink so buildozer can find python3
RUN ln -sf /usr/local/bin/python3 /usr/bin/python3 2>/dev/null || true

# The vendored recipes/lxst recipe copies LXST source from a hardcoded absolute
# path (the upstream maintainer's machine: /home/markqvist/Information/Source/LXST).
# recipes/ is a protected, byte-identical path, so we cannot edit the recipe — we
# instead place the LXST source at exactly that path inside the image so the
# `cp -a` in prepare_build_dir() succeeds.  LXST is markqvist's audio/telephony
# stack (PyPI `lxst`); it is independent of Reticulum/LXMF/Sideband core.
RUN mkdir -p /home/markqvist/Information/Source && \
    git clone --depth 1 https://github.com/markqvist/LXST.git \
        /home/markqvist/Information/Source/LXST

# codec2 cross-compilation: the CMakeLists uses `generate_codebook` as a bare
# command name (PATH lookup) when generating codebook C sources.  cmake 3.25
# (Debian bookworm) emits the bare name rather than the target path when
# CMAKE_CROSSCOMPILING=TRUE, so the arm64 NDK-built binary is never found.
# Pre-install a native x86_64 generate_codebook so make can run it as a generator.
RUN cd /tmp && \
    curl -sL "https://github.com/markqvist/codec2/archive/00e01c9d72d3b1607e165c71c4c9c942d277dfac.tar.gz" \
         -o codec2.tar.gz && \
    tar xf codec2.tar.gz && \
    cc codec2-00e01c9d72d3b1607e165c71c4c9c942d277dfac/src/generate_codebook.c \
       -lm -o /usr/local/bin/generate_codebook && \
    rm -rf codec2.tar.gz codec2-00e01c9d72d3b1607e165c71c4c9c942d277dfac

# opusfile cross-compilation: ./configure uses pkg-config to find ogg and opus.
# p4a doesn't install .pc files, and the recipe passes _env without PKG_CONFIG_PATH.
# This wrapper at /usr/local/bin/pkg-config (before /usr/bin in PATH) intercepts
# ogg/opus queries and returns the build-tree include/lib paths directly.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'B=/home/user/hostcwd/sbapp/.buildozer/android/platform/build-arm64-v8a/build/other_builds' \
  'OGG=$B/libogg/arm64-v8a__ndk_target_24/libogg' \
  'OPUS=$B/libopus/arm64-v8a__ndk_target_24/libopus' \
  'case "$*" in' \
  '  *ogg*|*opus*)' \
  '    CF="-I$OGG/include -I$OPUS/include"' \
  '    LF="-L$OGG/.libs -logg -L$OPUS/.libs -lopus"' \
  '    case "$*" in' \
  '      *--cflags*--libs*|*--libs*--cflags*) echo "$CF $LF"; exit 0;;' \
  '      *--cflags*) echo "$CF"; exit 0;;' \
  '      *--libs*) echo "$LF"; exit 0;;' \
  '      *) exit 0;;' \
  '    esac;;' \
  '  *) exec /usr/bin/pkg-config "$@";;' \
  'esac' \
  > /usr/local/bin/pkg-config && chmod +x /usr/local/bin/pkg-config

# patch_p4a.py: patches p4a recipe.py for vendored recipe compatibility:
#   1. adds get_python_root to TargetPythonRecipe (meson numpy needs it)
#   2. adds pip property shim to PythonRecipe.prebuild_arch (local HostPython3Recipe
#      has no pip attr; all _host_recipe.pip call sites fail without this)
# Stored as base64 to avoid shell-quoting the embedded Python source.
RUN echo "" \
    | base64 -d > /usr/local/bin/patch_p4a.py && chmod +x /usr/local/bin/patch_p4a.py

# Wrapper entrypoint: patches p4a before every buildozer run so the meson numpy
# recipe can call get_python_root even if p4a was freshly cloned this run.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'python3 /usr/local/bin/patch_p4a.py' \
  'exec buildozer "$@"' \
  > /usr/local/bin/buildozer-wrapper.sh && chmod +x /usr/local/bin/buildozer-wrapper.sh

WORKDIR /home/user/hostcwd
ENTRYPOINT ["/usr/local/bin/buildozer-wrapper.sh"]
